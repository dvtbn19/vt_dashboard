# ---- runtime -------------------------------------------------------------
ENV=development
# PostgreSQL (docker compose in infra/compose). For a quick try without Docker: sqlite:///./data/dev.db
DATABASE_URL=postgresql+psycopg://vtlab:vtlab@127.0.0.1:5432/vtlab
# auto = no connection pool on Vercel (each request opens/closes one), small pool elsewhere
DATABASE_POOL=auto
API_PUBLIC_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ---- auth ----------------------------------------------------------------
# local = development only (refused when ENV=production). supabase = verify Supabase JWTs.
AUTH_MODE=local
LOCAL_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
LOCAL_LOGIN_EMAIL=owner@example.com
LOCAL_LOGIN_PASSWORD=change-me
# Comma separated. Required in production; recommended always.
LAB_ALLOWED_EMAILS=owner@example.com

# Supabase (AUTH_MODE=supabase). New projects sign JWTs with asymmetric keys (verified via JWKS);
# set SUPABASE_JWT_SECRET only if your project still uses the legacy HS256 secret.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# ---- storage ---------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/artifacts
STORAGE_SIGNING_SECRET=change-me-to-another-random-string-of-32-chars

# Cloudflare R2 (STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: run read-only SQL from the Lab against an analysis database.
# MUST be a role that can only SELECT (e.g. Supabase `team_ro`). Empty = feature off.
ANALYTICS_DATABASE_URL=
QUERY_TIMEOUT_SECONDS=20
QUERY_MAX_ROWS=5000
