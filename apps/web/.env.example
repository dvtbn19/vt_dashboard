# Server-side URL of the FastAPI service (never exposed to the browser bundle).
API_URL=http://127.0.0.1:8000

# "local" (dev only, uses API /v1/auth/local-login) or "supabase".
LAB_AUTH_MODE=local

# Supabase (only when LAB_AUTH_MODE=supabase). The anon/publishable key is safe for browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: absolute URLs used for links between the portfolio and the lab.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional: give the lab its own host. With LAB_URL set, <lab host>/ redirects to /lab and
# /lab/* on the portfolio host redirects to the lab host. Leave empty for local development.
PORTFOLIO_URL=
LAB_URL=
